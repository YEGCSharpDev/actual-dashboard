FROM node:22-slim

# Set working directory
WORKDIR /app

# Install the official Actual CLI globally
RUN npm install --location=global @actual-app/cli

# Create a directory for Actual data (where the local database is cached)
# The CLI uses this to store the synchronized budget files.
RUN mkdir -p /app/.actual-data && chown node:node /app/.actual-data
VOLUME /app/.actual-data

# Switch to non-root user for security
USER node

# Set default environment variable for data directory
ENV ACTUAL_DATA_DIR=/app/.actual-data

# The CLI requires:
# - ACTUAL_SERVER_URL
# - ACTUAL_SYNC_ID
# - ACTUAL_PASSWORD (or ACTUAL_SESSION_TOKEN)
# - ACTUAL_ENCRYPTION_PASSWORD (if applicable)

# Use 'actual' as the entrypoint to allow passing commands directly
ENTRYPOINT ["actual"]

# Default to showing help if no command is provided
CMD ["--help"]
