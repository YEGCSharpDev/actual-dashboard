{
  "name": "actual-budget-dashboard-lean",
  "version": "1.0.0",
  "description": "A lean, modular, single-process dashboard for Actual Budget using Node.js, Express, and React",
  "main": "dist/backend/server.js",
  "scripts": {
    "postinstall": "npm install --prefix frontend",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "tsx watch backend/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/backend/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@actual-app/api": "^26.7.0",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/sqlite3": "^3.1.11",
    "concurrently": "^8.2.2",
    "eslint": "^10.5.0",
    "eslint-plugin-n": "^18.1.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.8"
  }
}
